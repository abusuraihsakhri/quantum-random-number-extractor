{
  "openapi": "3.1.0",
  "info": {
    "title": "Quantum Random Number Extractor API",
    "description": "Local bitstream extraction plus legacy heuristic metric-audit endpoints. No quantum source or standards certification is provided.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Return legacy in-memory JSON counters",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Apply legacy heuristic thresholds to numeric task metrics",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return local deterministic mock status response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Return in-memory HMAC chain and integrity result",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/extract": {
      "post": {
        "summary": "Apply von Neumann extraction to a supplied binary measurement stream",
        "description": "Accepts binary observation text. This is a bias demonstration, not a NIST SP 800-90B entropy assessment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bits": {
                    "type": "string",
                    "description": "0/1 symbols separated by whitespace, commas, semicolons or pipes"
                  }
                },
                "required": [
                  "bits"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extraction bits and descriptive input/output statistics"
          },
          "422": {
            "description": "Invalid bitstream"
          }
        }
      }
    }
  }
}
